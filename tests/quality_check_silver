/*

Script Purpose: This scripts perform various the quality check for data consistency , accuracy and standarization across silver schema.
                It include check:
              1) NULL or Duplicate primary key
              2)Unwanted spaces in the string field
              3)Data Standarization and consistancy
              4)Invalid date ranges and orders
              5)Data consistency between related field

Usage Notes :
            --Run check once data gets loaded to silver and if any descramancy are found then fixed them.

--Checking table crm_prd_info
--Check for NULL OR duplicate primary key
--Expection is empty result

SELECT 
prd_id,
COUNT(*) AS count_prd_id
FROM bronze.crm_prd_info
GROUP BY prd_id
HAVING COUNT(*) > 1 OR prd_id IS NULL;

--Checking the Normalize or Standarize for prd_line
SELECT 
DISTINCT prd_line
FROM bronze.crm_prd_info;

--PARTItion the prd key to cat_if for matching in erp_px_cat_g1v2  table id and to prd_key to match the sls_prd_key in crm_sales_details table
SELECT 
prd_id,
REPLACE(SUBSTRING(prd_key, 1, 5),'-','_') AS cat_id, --Substring by taking first 5 character and rep;acing - with _ as ero_px_cat table have _.
SUBSTRING(prd_key, 7, LEN(prd_key)) AS prd_key, --use the string from 7 to length of the string.
prd_nm,
ISNULL(prd_cost,0) AS prd_cost, --Replcaing the NULL with 0
CASE UPPER(TRIM(prd_line))  --Normatze and standartization mapping 
     WHEN 'M' THEN 'Mountain'
     WHEN 'R' THEN 'Road'
     WHEN 'S' THEN 'Other Sales'
     WHEN 'T' THEN 'Touring'
     ELSE 'n/a'
END AS prd_line,
CAST(prd_start_dt AS DATE) AS prd_start_dt,
CAST(DATEADD(DAY,-1 ,LEAD(prd_start_dt) OVER(PARTITION BY prd_nm ORDER BY prd_start_dt)) AS DATE) AS prd_end_dt
FROM bronze.crm_prd_info;

SELECT 
SUBSTRING(prd_key,7,LEN(prd_key)) AS sls_prd_key,
FROM bronze.crm_prd_info
WHERE SUBSTRING(prd_key,7,LEN(prd_key))  NOT IN(
SELECT 
sls_prd_key
